#!/usr/bin/expect -f
set timeout 15
log_user 0
set daemon [lindex $argv 0]
set testfile [lindex $argv 1]
set env(TERM) xterm
spawn ./lib-src/emacsclient -t -s $daemon
expect -re ".*"
send ":M-: (run-with-terminal-control \"less\" (list \"$testfile\"))\r"
expect "test content"
send "q"
send "\x18\x03"
expect eof
puts "PASS"
